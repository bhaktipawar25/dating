# Authentication Service Configuration
# Set NEXT_PUBLIC_AUTH_MODE=api when connecting to the live backend.
# Defaults to "mock" when no backend URL is provided so frontend flows can be tested safely.
NEXT_PUBLIC_AUTH_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional / configurable endpoints not fixed in the core auth spec.
# Leave unset if the backend is not yet exposing them.
NEXT_PUBLIC_AUTH_REGISTER_ENDPOINT=
NEXT_PUBLIC_AUTH_FORGOT_PASSWORD_ENDPOINT=
NEXT_PUBLIC_AUTH_RESET_PASSWORD_ENDPOINT=
NEXT_PUBLIC_AUTH_REFRESH_ENDPOINT=
NEXT_PUBLIC_AUTH_LOGOUT_ENDPOINT=
NEXT_PUBLIC_AUTH_ME_ENDPOINT=

# Optional Feature 3 profile preload endpoint (if exposed by backend)
NEXT_PUBLIC_PROFILE_GET_ENDPOINT=
